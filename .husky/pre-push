#!/bin/bash

# Pre-push hook to automatically bump version
# This hook runs before every git push
# It will only auto-bump if the version hasn't been manually changed

echo "🔄 Pre-push: Checking version status..."

# Get the version from the last commit (HEAD)
LAST_VERSION=$(git show HEAD:package.json | grep -o '"version": "[^"]*"' | cut -d'"' -f4)

# Get the current version in the working directory
CURRENT_VERSION=$(grep -o '"version": "[^"]*"' package.json | cut -d'"' -f4)

echo "📌 Last committed version: $LAST_VERSION"
echo "📌 Current version: $CURRENT_VERSION"

# Check if version was manually changed
if [ "$LAST_VERSION" != "$CURRENT_VERSION" ]; then
  echo "✅ Manual version change detected ($LAST_VERSION → $CURRENT_VERSION)"
  echo "⏭️  Skipping auto-bump. Proceeding with push..."
  exit 0
fi

# No manual changes, proceed with auto-bump
echo "🔄 No manual changes detected. Running auto-bump..."

# Run the version bump script
npm run version:bump

# Check if version bump was successful
if [ $? -ne 0 ]; then
  echo "❌ Version bump failed. Push aborted."
  exit 1
fi

# Stage the updated files
git add package.json src/version.ts

# Check if there are changes to commit
if git diff --cached --quiet; then
  echo "ℹ️  No version changes to commit"
else
  # Commit the version bump
  git commit -m "chore: bump version [skip ci]"

  if [ $? -ne 0 ]; then
    echo "❌ Failed to commit version bump. Push aborted."
    exit 1
  fi

  echo "✅ Version bumped and committed"
fi

echo "✅ Pre-push hook completed successfully"
exit 0
